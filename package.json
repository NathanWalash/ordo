{
  "name": "ordo",
  "private": true,
  "description": "Personal management desktop app for macOS and Windows. Mail first, with Unclutter built in.",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm --filter @ordo/desktop dev",
    "build": "pnpm --filter @ordo/desktop build",
    "package": "pnpm --filter @ordo/desktop package",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm build && playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "icon": "electron scripts/render-icon.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NathanWalash/ordo.git"
  }
}
